# InvokeAI-Meta - Project aliases and functions
# All commands defined here, sourced by .salias
# Run 'help' to see all available commands

# ── Environment ──
clear
set -gx ENV_NAME '.venv'
set -gx INVOKE_DIR (pwd)
set -gx INVOKE_DATA_DIR "$INVOKE_DIR/invokeai_data"
set -gx INVOKEAI_DB "$INVOKE_DATA_DIR/databases/invokeai.db"
set -gx PY_VERSION 3.12
set -gx IMD_AUTO_OPEN false
set -gx SVC_DASH http://localhost:8090
set -gx INVOKE_UNIT invokeai-web.service
set -gx INVOKE_URL http://localhost:9090

# Secrets come from .env (generated by mkdotenv from the SOPS vault), never from
# a literal in this file — this file is tracked and pushed to a public fork.
if test -f .env
    for line in (grep -v '^\s*#' .env | grep '=')
        set -l key (string split -m1 '=' $line)[1]
        set -l val (string split -m1 '=' $line)[2]
        set -gx $key $val
    end
end

# ── Python Environment ──
alias envclean='rmpyall;uvclean'

# uv.lock is tracked upstream and left alone — deleting it is what used to make every
# rebase conflict. Only our own generated state goes here.

# No `pnpm self-update` here any more: both frontends pin packageManager to pnpm@10.12.4
# and upstream tests on v10, so self-updating walks the toolchain away from the pin.
function install
    echo "Installing ./setup_dev.sh"
    cd $INVOKE_DIR
    ./setup_dev.sh
end

# Dependencies are now whatever the committed uv.lock says, and upstream's lock arrives
# with gitupdate — so "update" means re-sync to the lock, not resolve newer versions.
# Resolving (uv lock --upgrade) would rewrite the tracked uv.lock and leave the tree
# dirty, which blocks gitupdate.
function updateall
    echo "Syncing dependencies to uv.lock..."
    imd
    uv sync --frozen --python 3.12 --managed-python --extra dev --extra test --extra cuda
    or return $status
    echo "Done"
end

# ── Help ──
alias help='clear; cat ./.salias_help.txt'

# ── Server ──
# invokeai-web runs as a systemd user unit fronted by the Service Dashboard
# on :8090. Only invokeai-web is touched here — model-compare and invokepush
# are their own units in the media-stack group, started from the dashboard.
# 'restart' also starts a stopped unit, so one call covers both cases.
function run
    echo "Restarting $INVOKE_UNIT via the Service Dashboard ..."
    set -l result (curl -s -m 30 -w '\n%{http_code}' -X POST $SVC_DASH/api/services/$INVOKE_UNIT/restart)
    set -l code $result[-1]

    switch $code
        case 200
            # nothing to report yet — the readiness poll below speaks for it
        case 409
            echo "$INVOKE_UNIT is set to Disabled in the dashboard."
            echo "Change its mode at $SVC_DASH, then run again."
            return 1
        case 000
            echo "Service Dashboard is not reachable at $SVC_DASH"
            echo "Start it with: systemctl --user start porthub-service-dash.service"
            return 1
        case '*'
            echo "Dashboard returned HTTP $code"
            test (count $result) -gt 1; and echo $result[1..-2]
            return 1
    end

    # The unit is backgrounded by systemd, so wait for the API to answer rather
    # than handing back a prompt that points at a dead port.
    echo -n "Waiting for InvokeAI to come up "
    for i in (seq 60)
        if curl -sf -m 2 -o /dev/null $INVOKE_URL/api/v1/app/version
            echo ""
            echo "InvokeAI is up at $INVOKE_URL"
            if test "$IMD_AUTO_OPEN" = "true"
                xdg-open $INVOKE_URL &
            end

            exit
            return 0
        end
        echo -n "."
        sleep 2
    end

    echo ""
    echo "Timed out after 120s. Check the logs with: logs"
    return 1
end
function stop
    set -l found 0

    set existing_pids (pgrep -f invokeai-web)
    if test -n "$existing_pids"
        echo "Found InvokeAI server (PIDs: $existing_pids)"
        echo "Stopping server..."
        pkill -f invokeai-web
        set found 1
    end

    set ip_pids (pgrep -f "invokepush/web.py")
    if test -n "$ip_pids"
        echo "Found invokepush service (PIDs: $ip_pids)"
        echo "Stopping invokepush..."
        pkill -f "invokepush/web.py"
        set found 1
    end

    if test $found -eq 1
        sleep 2
        echo "Services stopped"
        sleep 5
    else
        echo "No InvokeAI services are currently running"
    end
end
alias restart='stop;run'

# ── Development ──
# v7 split the frontend in two: webv2 is the UI the server mounts at /, webv1 is the
# legacy UI, needed only for `invokeai-web --web-legacy` (/static is served from the
# committed webv1/static source, so it needs no build). build-ui builds webv2;
# `build-ui --legacy` adds webv1.
#
# webv1 still wires vite-plugin-eslint into its vite config, gated on `mode !== 'test'`,
# and that plugin crashes V8 on Node 25+ — so it needs --mode test.
# Kept in step with the same logic in setup_dev.sh.
set -gx INVOKE_UI_DIRS invokeai/frontend/webv2 invokeai/frontend/webv1
set -gx INVOKE_UI_MODES '' '--mode test'
# .nvmrc pins the v22 line; this box's system node is much newer, so build under fnm's
# v22 when fnm is there. __invoke_node wraps a command in that choice.
function __invoke_node
    if command -q fnm
        fnm exec --using=22 -- $argv
    else
        echo "Warning: fnm not found; using system node "(node -v)" (.nvmrc wants "(cat $INVOKE_DIR/.nvmrc)")" >&2
        $argv
    end
end
function build-ui
    imd
    set -l n 1
    contains -- --legacy $argv; and set n 2
    for i in (seq $n)
        set -l ui $INVOKE_UI_DIRS[$i]
        set -l mode (string split ' ' -- $INVOKE_UI_MODES[$i] | string match -v '')
        echo "Building $ui ..."
        pushd $ui
        __invoke_node pnpm install --frozen-lockfile
        and __invoke_node pnpm exec vite build $mode
        set -l rc $status
        popd
        test $rc -eq 0; or begin
            echo "Build failed in $ui" >&2
            return $rc
        end
    end
    echo "Done"
end
function dev
    imd
    echo "Starting InvokeAI in development mode..."
    echo "Backend will run at http://127.0.0.1:9090"
    echo "Frontend will run at http://127.0.0.1:5173"
    echo ""

    invokeai-web --root $INVOKE_DATA_DIR &
    set -l backend_pid $last_pid

    cd $INVOKE_UI_DIRS[1]
    pnpm dev

    kill $backend_pid
end

# ── Maintenance ──
function clean
    echo "Cleaning build artifacts..."
    imd
    for ui in $INVOKE_UI_DIRS
        rm -rf $ui/dist $ui/node_modules/.vite
    end
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null
    echo "Done"
end
function logs
    tail -f $INVOKE_DATA_DIR/logs/invokeai.log
end

# ── Git ──
# gitupdate itself is the global fish function (~/.config/fish/functions/gitupdate.fish)
# — this file used to carry a copy, but the two had to be kept in sync by hand.
# Do NOT redefine it here: a local definition is sourced on dir-entry and shadows
# the global one.
#
# mryan carries ONLY files upstream does not have (this file, setup_dev.sh, CLAUDE.md;
# setup_dev.sh creates the scripts/ symlinks into invokeai-claude-fixes). Nothing upstream-owned is edited
# or deleted, so a rebase has nothing to conflict over and gitupdate needs no autodrop
# rules. Keep it that way: a patch to an upstream file is a cost paid on every sync.
# Local-only paths (invokeai_data, .env*) are excluded via .git/info/exclude, written
# by setup_dev.sh, rather than by editing upstream's .gitignore.

# upstream is fetch-only. Both halves live in .git/config, which is per-clone and
# untracked, so a fresh clone has neither: gitupdate can't fetch without the remote,
# and nothing stops a stray `git push upstream` aiming our commits at invoke-ai's repo.
# A bogus push URL fails instantly and leaves fetch working. Re-checked on dir entry.
git remote | string match -q upstream
or git remote add upstream https://github.com/invoke-ai/InvokeAI.git
git remote get-url --push upstream 2>/dev/null | string match -q DISABLED_no_pushing_to_upstream
or git remote set-url --push upstream DISABLED_no_pushing_to_upstream

# Units that execute this repo's code (and this repo's .venv). gitupdate restarts
# them after a sync so they don't keep running the pre-rebase code — but only the
# ones that were already up, so a stack left stopped on purpose stays stopped.
# invokepush and invokeai7-web run from other checkouts, so they are not listed.
for unit in $INVOKE_UNIT model-compare.service
    git config --get-all gitupdate.restartunit | string match -q -- $unit
    or git config --add gitupdate.restartunit $unit
end

# ── Models ──
# Restart the units an update took down — and only those. Goes through the same
# dashboard endpoint `run` uses so the dashboard's own bookkeeping stays right.
function __invoke_restore_units
    for unit in $argv
        echo "Restarting $unit ..."
        set -l code (curl -s -m 60 -o /dev/null -w '%{http_code}' -X POST $SVC_DASH/api/services/$unit/restart)
        test "$code" = 200; or echo "Warning: dashboard returned HTTP $code restarting $unit" >&2
    end
end

# Hub scripts run on this checkout's venv explicitly: bare `python` only works when
# direnv has activated .venv, and they import invokeai even in the filter phase.
function __invoke_hub_py
    $INVOKE_DIR/.venv/bin/python $INVOKE_DIR/scripts/$argv[1] \
        --invokeai-db $INVOKEAI_DB \
        --invokeai-models $INVOKE_DATA_DIR/models \
        $argv[2..-1]
end

# Run $argv with InvokeAI off the models DB and the hub API up, then restore
# exactly the units that were running before.
function __invoke_hub_session
    # The update needs InvokeAI to let go of the models DB, but it must not *start*
    # a stack that was deliberately left stopped. Record what is up now and put
    # back exactly that at the end.
    set -l was_up (svcgroup invokeai status | string match -rg '^\s+(\S+\.service)\s+running')
    if test (count $was_up) -gt 0
        echo "Running, will be restarted afterwards: "(string join ', ' $was_up)
        # Call svcgroup directly, NOT the svstop/svr aliases: those end in `exit`
        # (they're meant for "stop the stack and close this window"), which would
        # kill the shell before the hub script ever runs.
        svcgroup invokeai stop
        or return $status
    else
        echo "No InvokeAI units are running — they will be left stopped."
    end

    # hub_import reads the hub over its API (127.0.0.1:8000) rather than its SQLite
    # file, so the import phase needs hubroot up. Only hubroot: what the stop above
    # is really for is InvokeAI letting go of the models DB, and hubroot never
    # touches that DB. Already running in the usual case — start is idempotent.
    systemctl --user start hubroot
    or return $status
    set -l hub_up 0
    for i in (seq 30)
        if curl -sf -m 2 -o /dev/null http://127.0.0.1:8000/api/health
            set hub_up 1
            break
        end
        sleep 1
    end
    if test $hub_up -eq 0
        echo "Hub API never came up on http://127.0.0.1:8000 — aborting" >&2
        __invoke_restore_units $was_up
        return 1
    end

    $argv
    set -l rc $status
    __invoke_restore_units $was_up
    return $rc
end

function up
    clear
    imd
    __invoke_hub_session __invoke_hub_py hub_update.py $argv
end

function __invoke_reset
    echo "Resetting InvokeAI models DB and symlinks..."
    echo "Data dir: $INVOKE_DATA_DIR"
    echo ""
    __invoke_hub_py hub_import.py --reset --no-import $argv
    or return $status

    echo ""
    read -P "Reimport? (Y/n) " -l reply
    switch (string lower -- $reply)
        case n no
            echo "Skipping re-import."
        case '*'
            __invoke_hub_py hub_import.py $argv
    end
end
function reset
    imd
    __invoke_hub_session __invoke_reset $argv
end
function ipush
    python /home/dev/work/media/invokedev/invokepush/web.py $argv
end

# ── Secrets (SOPS vault) ──
# .env.keys lists the ENV_VAR=vault-key pairs this project needs (one per line).
# .env is generated and gitignored, so no secret ever lands in a tracked file.
function mkdotenv
    set -l keys_file (dirname (status filename))/.env.keys
    set -l env_file (dirname (status filename))/.env
    if not test -f "$keys_file"
        echo "Error: .env.keys manifest not found"
        return 1
    end
    rm -f "$env_file"
    for line in (grep -v '^\s*#' "$keys_file" | grep '=')
        set -l env_var (string split -m1 '=' $line)[1]
        set -l vault_key (string split -m1 '=' $line)[2]
        set -l val (sops -d --extract "[\"$vault_key\"]" ~/.config/sops/vault.yaml)
        if test $status -ne 0
            echo "Error: could not read '$vault_key' from SOPS vault."
            rm -f "$env_file"
            return 1
        end
        echo "$env_var=$val" >> "$env_file"
    end
    echo ".env created from the SOPS vault."
end

function rmdotenv
    set -l env_file (dirname (status filename))/.env
    if test -f "$env_file"
        rm "$env_file"
        echo ".env deleted."
    else
        echo ".env not found."
    end
end
