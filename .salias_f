# InvokeAI-Meta - Project aliases and functions
# All commands defined here, sourced by .salias
# Run 'help' to see all available commands

# ── Environment ──
clear
set -gx ENV_NAME '.venv'
set -gx INVOKE_DIR (pwd)
set -gx INVOKE_DATA_DIR "$INVOKE_DIR/invokeai_data"
set -gx INVOKEAI_DB "$INVOKE_DATA_DIR/databases/invokeai.db"
set -gx PY_VERSION 3.12.10
set -gx IMD_AUTO_OPEN false

# ── Python Environment ──
alias envclean='rmpyall;uvclean'
alias mkenv='gitupdate;mkuv $ENV_NAME $PY_VERSION;build-ui'
alias rmenv='rm -rf $ENV_NAME uv.lock .envrc; exit'
function install
    echo "Installing ./setup_dev.sh"
    cd $INVOKE_DIR
    pnpm self-update
    ./setup_dev.sh
end
function updateall
    echo "Updating dependencies..."
    imd
    uv pip install -e ".[dev,test,docs]" --python 3.12 --torch-backend=cu128 --upgrade
    echo "Done"
end

# ── Help ──
alias help='clear; cat /home/dev/work/media/invokedev/InvokeAI-Meta/.salias_help.txt'

# ── Server ──
function run
    set existing_pids (pgrep -f invokeai-web)
    if test -n "$existing_pids"
        echo "Found existing InvokeAI server (PIDs: $existing_pids)"
        echo "Stopping existing server..."
        pkill -f invokeai-web
        sleep 2
    end
    pkill -f "model_compare/server.py" 2>/dev/null
    pkill -f "invokepush/web.py" 2>/dev/null

    echo "Starting Model Compare service on http://localhost:9091 ..."
    python $INVOKE_DIR/scripts/model_compare/server.py \
        --invokeai-db $INVOKE_DATA_DIR/databases/invokeai.db &
    set -g modelcompare_pid $last_pid

    echo "Starting invokepush on http://localhost:9092 ..."
    python /home/dev/work/media/invokedev/invokepush/web.py &
    set -g invokepush_pid $last_pid

    # Open browser tabs after InvokeAI has time to start
    if test "$IMD_AUTO_OPEN" = "true"
        fish -c "sleep 5; xdg-open http://localhost:8000; xdg-open http://localhost:9090; xdg-open http://localhost:9091; xdg-open http://localhost:9092" &
    end

    echo "Starting InvokeAI server..."
    invokeai-web --root $INVOKE_DATA_DIR

    kill $modelcompare_pid 2>/dev/null
    kill $invokepush_pid 2>/dev/null
end
function stop
    set -l found 0

    set existing_pids (pgrep -f invokeai-web)
    if test -n "$existing_pids"
        echo "Found InvokeAI server (PIDs: $existing_pids)"
        echo "Stopping server..."
        pkill -f invokeai-web
        set found 1
    end

    set mc_pids (pgrep -f "model_compare/server.py")
    if test -n "$mc_pids"
        echo "Found Model Compare service (PIDs: $mc_pids)"
        echo "Stopping Model Compare..."
        pkill -f "model_compare/server.py"
        set found 1
    end

    set ip_pids (pgrep -f "invokepush/web.py")
    if test -n "$ip_pids"
        echo "Found invokepush service (PIDs: $ip_pids)"
        echo "Stopping invokepush..."
        pkill -f "invokepush/web.py"
        set found 1
    end

    if test $found -eq 1
        sleep 2
        echo "Services stopped"
        sleep 5
        exit
    else
        echo "No InvokeAI services are currently running"
    end
end
alias restart='stop;run'

# ── Development ──
function build-ui
    echo "Building frontend..."
    imd
    cd invokeai/frontend/web
    pnpm install
    pnpm exec vite build --mode test
    echo "Done"
end
function dev
    imd
    echo "Starting InvokeAI in development mode..."
    echo "Backend will run at http://127.0.0.1:9090"
    echo "Frontend will run at http://127.0.0.1:5173"
    echo ""

    invokeai-web --root $INVOKE_DATA_DIR &
    set -l backend_pid $last_pid

    cd invokeai/frontend/web
    pnpm dev

    kill $backend_pid
end

# ── Maintenance ──
function clean
    echo "Cleaning build artifacts..."
    imd
    rm -rf invokeai/frontend/web/dist
    rm -rf invokeai/frontend/web/node_modules/.vite
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null
    echo "Done"
end
alias data='cd $INVOKE_DATA_DIR/databases'
function logs
    tail -f $INVOKE_DATA_DIR/logs/invokeai.log
end

# ── Git ──
function gitupdate
    imd
    set -l current_branch (git branch --show-current)

    if not git diff --quiet; or not git diff --cached --quiet
        echo "Error: working tree has uncommitted changes. Commit or stash first."
        return 1
    end

    echo "Fetching upstream..."
    git fetch upstream; or return $status

    echo "Updating main..."
    git checkout main; or return $status
    git merge upstream/main --ff-only; or begin
        echo "Error: main is not fast-forwardable from upstream/main."
        git checkout $current_branch
        return 1
    end
    git push origin main; or return $status

    echo "Rebasing mryan onto main..."
    git checkout mryan; or return $status
    if not git rebase main
        echo ""
        echo "Error: rebase of mryan onto main failed."
        echo "Resolve the conflicts and run 'git rebase --continue',"
        echo "or run 'git rebase --abort' to back out."
        echo "Skipping push and pull."
        return 1
    end
    git push origin mryan --force-with-lease; or return $status

    git checkout $current_branch; or return $status
    if test "$current_branch" = "main"; or test "$current_branch" = "mryan"
        git pull; or return $status
    else
        echo "Rebasing $current_branch onto mryan..."
        if not git rebase mryan
            echo ""
            echo "Error: rebase of $current_branch onto mryan failed."
            echo "Resolve the conflicts and run 'git rebase --continue',"
            echo "or run 'git rebase --abort' to back out."
            echo "Skipping push."
            return 1
        end
        git push origin $current_branch --force-with-lease; or return $status
    end
    echo "Branches synced"
end

# ── Models ──
function hubimport
    imd
    stop
    python scripts/hub_import.py \
        --invokeai-db $INVOKE_DATA_DIR/databases/invokeai.db \
        --invokeai-models $INVOKE_DATA_DIR/models \
        $argv
end
function hubreset
    imd
    stop
    echo "Resetting InvokeAI models DB and symlinks..."
    echo "Data dir: $INVOKE_DATA_DIR"
    echo ""
    python scripts/hub_import.py \
        --invokeai-db $INVOKE_DATA_DIR/databases/invokeai.db \
        --invokeai-models $INVOKE_DATA_DIR/models \
        --reset --no-import $argv
    or return $status

    echo ""
    read -P "Reimport? (Y/n) " -l reply
    switch (string lower -- $reply)
        case n no
            echo "Skipping re-import."
        case '*'
            python scripts/hub_import.py \
                --invokeai-db $INVOKE_DATA_DIR/databases/invokeai.db \
                --invokeai-models $INVOKE_DATA_DIR/models \
                $argv
    end
end
function ipush
    python /home/dev/work/media/invokedev/invokepush/web.py $argv
end
